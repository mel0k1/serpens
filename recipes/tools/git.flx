[package]
name = "git"
version = "2.45.2"
description = "Распределённая система контроля версий"
homepage = "https://git-scm.com/"
license = "GPL-2.0"

[source]
url = "https://www.kernel.org/pub/software/scm/git/git-2.45.2.tar.xz"

[dependencies]
build = ["curl>=8.0", "zlib>=1.2", "openssl>=3.0"]

[flags]
default = ["curl", "ssl"]

[build]
configure = ["./configure --prefix=/usr --with-curl"]
compile = ["make -j${NPROC}"]
install = ["make DESTDIR=${D} install"]
