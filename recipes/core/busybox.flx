[package]
name = "busybox"
version = "1.36.1"
description = "Один бинарник со множеством классических утилит Unix"
homepage = "https://busybox.net/"
license = "GPL-2.0"

[source]
url = "https://busybox.net/downloads/busybox-1.36.1.tar.bz2"

[flags]
default = ["static"]

[build]
prepare = [
  "make defconfig",
  '''sed -i 's/^CONFIG_TC=y/# CONFIG_TC is not set/' .config''',
  '''if use static; then sed -i 's/^# CONFIG_STATIC is not set/CONFIG_STATIC=y/' .config; fi''',
]
compile = ["make -j${NPROC}"]
install = [
  "make CONFIG_PREFIX=${D}/usr install",
  '''mkdir -p "$D/bin" "$D/usr/bin" && ln -sf busybox "$D/usr/bin/sh" && ln -sf /usr/bin/busybox "$D/bin/sh"''',
]
