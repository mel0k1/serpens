{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/serpens/serpens.ascii",
    "color": {
      "1": "magenta",
      "2": "bright_magenta"
    }
  },
  "display": {
    "color": {
      "keys": "magenta",
      "title": "bright_magenta"
    },
    "separator": "  "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name-colored-string} на {host-name}"
    },
    "divider",
    {
      "type": "os",
      "key": " OS"
    },
    {
      "type": "kernel",
      "key": " Ядро"
    },
    {
      "type": "packages",
      "key": " Пакеты"
    },
    {
      "type": "shell",
      "key": " Шелл"
    },
    {
      "type": "terminal",
      "key": " Терминал"
    },
    {
      "type": "cpu",
      "key": " CPU"
    },
    {
      "type": "gpu",
      "key": " GPU"
    },
    {
      "type": "memory",
      "key": " Память"
    },
    {
      "type": "uptime",
      "key": " Аптайм"
    },
    "break",
    "colors"
  ]
}
